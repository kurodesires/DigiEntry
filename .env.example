# SMTP: use a campus app password or transactional email credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=digientry@example.com
SMTP_PASS=replace-with-provider-credential
MAIL_FROM="DigiEntry <digientry@example.com>"

# Use a separate long random key on the campus QR scanner device.
SCANNER_API_KEY=replace-with-a-different-long-random-secret

# Optional
PORT=3000
DATA_DIR=./data
