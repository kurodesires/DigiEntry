# Gmail SMTP: use a Google App Password (not the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=digientrypass@gmail.com
SMTP_PASS=
MAIL_FROM="DigiEntry <digientrypass@gmail.com>"

# Use a separate long random key on the campus QR scanner device.
SCANNER_API_KEY=replace-with-a-different-long-random-secret

# Optional
PORT=3000
DATA_DIR=./data

# Cloudflare Workers uses Gmail implicit TLS on port 465 instead.
# Set SMTP_PORT=465 in Cloudflare Worker secrets; never commit SMTP_PASS.

